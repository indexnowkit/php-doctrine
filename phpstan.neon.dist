# Standalone configuration for the split repository; the monorepo uses php/phpstan.neon.dist with the same level and rules.
includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
    level: 9
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    excludePaths:
        # DBAL 3 flavour (bool return types) cannot be analysed against DBAL 4 signatures
        - src/Middleware/IndexNowConnectionV3.php
