# Level 9 with phpstan-strict-rules; the monorepo CI runs this same file per package.
includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
    level: 9
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    excludePaths:
        # DBAL 3 flavour (bool return types) cannot be analysed against DBAL 4 signatures
        - src/Middleware/IndexNowConnectionV3.php
