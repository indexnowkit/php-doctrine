# The DBAL 3 / ORM 2 flavour (ci:install:dbal3): analyses Middleware\IndexNowConnectionV3 instead of the DBAL 4
# IndexNowConnection; everything else is phpstan.neon.dist. No baseline: the code reads the ORM 2 arrays and the
# ORM 3 mapping objects in a way both type sets accept.
includes:
    - phpstan.neon.dist
parameters:
    # replaces (not merges) the excludePaths of phpstan.neon.dist
    excludePaths!:
        analyse: []
        analyseAndScan:
            # DBAL 4 flavour (void return types) cannot be analysed against DBAL 3 signatures
            - src/Middleware/IndexNowConnection.php
