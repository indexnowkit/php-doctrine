{
    "name": "indexnowkit/doctrine",
    "description": "Doctrine ORM integration for IndexNow: #[IndexNow] attribute on entities, commit-safe URL submission via DBAL driver middleware.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "indexnow",
        "doctrine",
        "doctrine-orm",
        "seo",
        "yandex",
        "bing"
    ],
    "homepage": "https://github.com/indexnowkit/php-doctrine",
    "support": {
        "issues": "https://github.com/indexnowkit/php/issues",
        "source": "https://github.com/indexnowkit/php-doctrine",
        "docs": "https://github.com/indexnowkit/php-doctrine/blob/main/README.md",
        "security": "https://github.com/indexnowkit/php-doctrine/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "indexnowkit/core": "^0.2.2 || ^0.3",
        "doctrine/orm": "^2.19 || ^3.0",
        "doctrine/dbal": "^3.8 || ^4.0",
        "doctrine/event-manager": "^1.2 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/cache": "^6.4 || ^7.0",
        "symfony/var-exporter": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "IndexNowKit\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\Doctrine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "ci:install:highest": "@composer update --no-interaction --prefer-dist",
        "ci:install:lowest": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable",
        "ci:install:dbal3": "@composer update --no-interaction --prefer-dist --with doctrine/dbal:^3.8 --with doctrine/orm:^2.19"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
